      "css": ".ds-export{font-family:var(--font,'Manrope',sans-serif);width:100%;display:flex;align-items:center;justify-content:center;gap:8px;border:0;background:#28352d;color:white;border-radius:8px;min-height:44px;font-size:11px;font-weight:700;cursor:pointer}.ds-export:hover:not(:disabled){background:#3c4e3a}.ds-export>span{font-size:8px;background:#46593f;padding:4px 6px;border-radius:4px;color:#d5e8bd;margin-left:3px;font-weight:500}.ds-export:disabled{opacity:.48;cursor:not-allowed}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-export:focus-visible,.ds-icon:focus-visible,.ds-text:focus-visible,.ds-nav-item:focus-visible,.ds-scene-number:focus-visible,.ds-chapter:focus-visible{outline:3px solid #7c9364;outline-offset:3px;}"
