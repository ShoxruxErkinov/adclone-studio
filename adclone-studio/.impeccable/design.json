      "refersTo": "button-primary",
      "description": "Lime action used to import a product or create a script.",
      "html": "<button class=\"ds-primary\">Mahsulotni olish <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></button>",
      "css": ".ds-primary{font-family:var(--font,'Manrope',sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:8px;min-height:40px;padding:10px 16px;font-size:11px;font-weight:750;background:var(--green,#d7f594);color:#2b3928;cursor:pointer}.ds-primary:hover:not(:disabled){background:#caee81}.ds-primary:disabled{opacity:.48;cursor:not-allowed}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-export:focus-visible,.ds-icon:focus-visible,.ds-text:focus-visible,.ds-nav-item:focus-visible,.ds-scene-number:focus-visible,.ds-chapter:focus-visible{outline:3px solid #7c9364;outline-offset:3px;}"
    },
