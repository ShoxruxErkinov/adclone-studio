    {
      "name": "Four-scene editor and chapter timeline",
      "kind": "custom",
      "refersTo": "chapter-hook",
      "description": "Static specimen of the synchronized current-scene state. Production buttons seek the live player; this snippet has no playback runtime.",
      "html": "<section class=\"ds-story\"><div class=\"ds-scene\"><button class=\"ds-scene-number\" aria-label=\"1-sahnani ko‘rish\">01</button><div class=\"ds-scene-content\"><div class=\"ds-scene-label\"><label for=\"ds-scene-copy\">Hook</label><span>0:00 – 0:03</span></div><textarea class=\"ds-scene-copy\" id=\"ds-scene-copy\">Mahsulotingiz. Yangi hikoya.</textarea></div></div><div class=\"ds-timeline\" aria-label=\"Sahnalar ketma-ketligi\"><button class=\"ds-chapter ds-hook ds-active\">Hook</button><button class=\"ds-chapter ds-problem\">Muammo</button><button class=\"ds-chapter ds-solution\">Yechim</button><button class=\"ds-chapter ds-cta\">CTA</button></div></section>",
      "css": ".ds-story{font-family:var(--font,'Manrope',sans-serif);color:var(--ink,#262c2c)}.ds-scene{display:flex;align-items:flex-start;gap:11px}.ds-scene-number{font-family:var(--font,'Manrope',sans-serif);width:30px;min-width:30px;height:30px;border:0;border-radius:7px;font-size:10px;font-weight:750;margin-top:1px;background:#ede7f7;color:#786297;outline:1px solid currentColor;outline-offset:2px;cursor:pointer}.ds-scene-content{flex:1;min-width:0}.ds-scene-label{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:0 0 7px;height:20px}.ds-scene-label label{font-size:11px;font-weight:750}.ds-scene-label span{font-size:9px;color:#616c62;font-variant-numeric:tabular-nums}.ds-scene-copy{font-family:var(--font,'Manrope',sans-serif);width:100%;font-size:11px;line-height:1.7;padding:10px 12px;border:1px solid #e7eae6;min-height:58px;resize:vertical;border-radius:7px;background:white;color:var(--ink,#262c2c)}.ds-scene-copy:focus,.ds-scene-copy:focus-visible{outline:0;border-color:#99af83;box-shadow:0 0 0 3px #e5efd9}.ds-timeline{display:flex;gap:4px;margin:17px 0 19px;height:32px}.ds-chapter{font-family:var(--font,'Manrope',sans-serif);border:0;border-radius:4px;flex:1;font-size:8px;font-weight:650;color:#646d62;position:relative;min-width:0;cursor:pointer}.ds-hook{background:#e8e2f1}.ds-problem{background:#f1e6d7}.ds-solution{background:#e2ebda;flex:1.4}.ds-cta{background:#e2e8f1}.ds-active:after{content:'';height:3px;background:#7d8a6c;position:absolute;bottom:0;left:0;right:0;border-radius:2px}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-export:focus-visible,.ds-icon:focus-visible,.ds-text:focus-visible,.ds-nav-item:focus-visible,.ds-scene-number:focus-visible,.ds-chapter:focus-visible{outline:3px solid #7c9364;outline-offset:3px;}"
    },
    {
      "name": "Confirmation dialog",
      "kind": "custom",
      "refersTo": "confirmation-dialog",
      "description": "Native modal confirmation with cancel initially focused, Escape cancellation, and focus restoration after dismissal. The open specimen displays the surface without a modal runtime; its backdrop CSS applies when production calls showModal().",
      "html": "<dialog open class=\"ds-confirm-dialog\" aria-labelledby=\"ds-confirmation-title\"><h2 id=\"ds-confirmation-title\">O‘zgarishni tasdiqlang</h2><p>Saqlanmagan o‘zgarishlar bor. Davom etilsinmi?</p><div class=\"ds-confirm-actions\"><button autofocus class=\"ds-confirm-secondary\">Bekor qilish</button><button class=\"ds-confirm-primary\">Davom etish</button></div></dialog>",
      "css": ".ds-confirm-dialog{font-family:var(--font,'Manrope',sans-serif);border:0;border-radius:14px;padding:28px;background:#fff;color:var(--ink,#262c2c);width:min(420px,calc(100vw - 36px));box-shadow:0 16px 70px #1b302b38}.ds-confirm-dialog::backdrop{background:#16251d80}.ds-confirm-dialog h2{margin:0;font-size:17px;letter-spacing:-.4px;font-weight:750}.ds-confirm-dialog p{font-size:13px;line-height:1.8;color:#616c62;margin:14px 0 23px}.ds-confirm-actions{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}.ds-confirm-primary,.ds-confirm-secondary{font-family:var(--font,'Manrope',sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:8px;min-height:40px;padding:10px 16px;font-size:11px;font-weight:750;white-space:nowrap;cursor:pointer}.ds-confirm-primary{border:0;background:var(--green,#d7f594);color:#2b3928}.ds-confirm-primary:hover:not(:disabled){background:#caee81}.ds-confirm-secondary{background:white;color:var(--ink,#262c2c);border:1px solid #dfe5e0}.ds-confirm-secondary:hover:not(:disabled){background:#f1f5ee}.ds-confirm-primary:focus-visible,.ds-confirm-secondary:focus-visible{outline:3px solid #7c9364;outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Operate",
    "overview": "Operate is the implementation-derived direction for AdClone Studio: dark forest navigation frames a warm white working area, with lime actions and restrained pastel chapter markers. It is a compact, practical editing workspace whose visual hierarchy keeps the product, script, and resulting vertical video together. The name describes the implemented system; it is not a claim of subjective user approval.\n\nThe distinctive interaction is a four-scene script connected to a synchronized chapter timeline. Numbered script rows, time ranges, matching chapter colors, and a live 9:16 preview make editing concrete. The Uzbek interface uses clear product language and visible service states. PRODUCT.md records the confirmed customer SaaS direction, Vercel + Supabase target, and keyless local trial; those commitments inform truthful status labels, not a separate visual theme.",
    "keyCharacteristics": [
      "Dark forest navigation, white panels, and a lightly tinted workspace.",
      "Lime creation actions and a darker export action.",
      "Locally served Manrope with compact labels and Lucide outline icons.",
      "Four editable scenes synchronized with the preview chapter timeline.",
      "Border-led surfaces, limited shadows, and explicit keyboard focus."
    ],
    "rules": [],
    "dos": [
      "Do retain the dark navigation, pale workspace, and white panel hierarchy.",
      "Do use lime for primary creation actions and forest for MP4 export.",
      "Do preserve the four scene colors, labels, time ranges, and synchronized active states.",
      "Do use locally served Manrope and Lucide outline icons with accessible names on icon-only actions.",
      "Do apply the final secondary-text and placeholder overrides, visible focus, and reduced-motion behavior.",
      "Do label sample content, keyless mode, provider availability, and render state truthfully."
    ],
    "donts": [
      "Don't describe this implementation-derived direction as a user-approved visual choice.",
      "Don't turn the pastel video themes into the global application chrome.",
      "Don't add ambient shadows to every panel; use borders and tonal separation for ordinary surfaces.",
      "Don't rely on color alone for chapters, selection, errors, or service availability.",
      "Don't replace the synchronized chapter controls with a decorative timeline.",
      "Don't imply that unconfigured AI providers or billing are active."
    ]
  }
}
