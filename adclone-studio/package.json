{
  "name": "adclone-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3000",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "build": "next build",
    "start": "node scripts/dev.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/bundler": "4.0.541",
    "@remotion/player": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "@supabase/supabase-js": "2.119.0",
    "cheerio": "1.2.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
