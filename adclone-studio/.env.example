# Optional. Copy to .env.local and restart npm run dev.
# No key is required for the loopback-only development demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Worker ONLY. Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://127.0.0.1:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Select a model that supports your target language in your ElevenLabs account.
ELEVENLABS_MODEL_ID=eleven_v3
FIRECRAWL_API_KEY=
REMOVE_BG_API_KEY=
# Optional absolute Chrome executable path. Auto-detected on Windows.
CHROME_EXECUTABLE=
RENDER_CONCURRENCY=2
# Production blocks the local demo unless explicitly enabled for loopback smoke testing.
ALLOW_LOCAL_DEMO=false
PORT=3000
